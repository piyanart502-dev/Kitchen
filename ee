/* ===== Modern skin: section colors match the LINE rich menu (temp blue, grease green, stock orange) ===== */
:root{
  --bg:#E8EEF3; --app:#F3F6F9; --surface:#FFFFFF; --sunk:#EEF2F6; --ink:#121B22; --muted:#5F6E78; --line:#DCE3E9;
  --accent:#17598F; --accent-2:#2C7DBF; --accent-soft:#E2EDF7;
  --c-temp:#2C7DBF; --c-temp-2:#17598F; --c-temp-soft:#E1EEF9;
  --c-grease:#139178; --c-grease-2:#0C6E5A; --c-grease-soft:#DDF3EC;
  --c-seas:#E07E14; --c-seas-2:#B45606; --c-seas-soft:#FCEBD8;
  --glass:rgba(255,255,255,.84); --glass-line:rgba(255,255,255,.7);
  --shadow:0 1px 2px rgba(16,40,60,.05),0 8px 24px rgba(16,40,60,.07);
  --shadow-lg:0 14px 40px rgba(16,40,60,.16);
  --r:20px;
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --bg:#090E12; --app:#0F151A; --surface:#172027; --sunk:#121A20; --ink:#E7EEF2; --muted:#93A3AD; --line:#26323A;
  --accent:#6DB0DD; --accent-2:#4A97CC; --accent-soft:#16304A;
  --c-temp:#5AA6E0; --c-temp-2:#2C7DBF; --c-temp-soft:#15304A;
  --c-grease:#3CC4A2; --c-grease-2:#139178; --c-grease-soft:#11342C;
  --c-seas:#F2A04A; --c-seas-2:#D9740F; --c-seas-soft:#3A2814;
  --glass:rgba(23,32,39,.86); --glass-line:rgba(255,255,255,.06);
  --shadow:0 1px 2px rgba(0,0,0,.4); --shadow-lg:0 14px 40px rgba(0,0,0,.5);
}}
:root[data-theme="dark"]{
  --bg:#090E12; --app:#0F151A; --surface:#172027; --sunk:#121A20; --ink:#E7EEF2; --muted:#93A3AD; --line:#26323A;
  --accent:#6DB0DD; --accent-2:#4A97CC; --accent-soft:#16304A;
  --c-temp:#5AA6E0; --c-temp-2:#2C7DBF; --c-temp-soft:#15304A;
  --c-grease:#3CC4A2; --c-grease-2:#139178; --c-grease-soft:#11342C;
  --c-seas:#F2A04A; --c-seas-2:#D9740F; --c-seas-soft:#3A2814;
  --glass:rgba(23,32,39,.86); --glass-line:rgba(255,255,255,.06);
  --shadow:0 1px 2px rgba(0,0,0,.4); --shadow-lg:0 14px 40px rgba(0,0,0,.5);
}
body{background:var(--bg)}
.app{background:radial-gradient(120% 60% at 100% 0%,var(--accent-soft) 0%,transparent 55%),var(--app);padding-bottom:calc(var(--nav-h) + 44px + env(safe-area-inset-bottom,0px))}
.appbar{background:var(--glass);-webkit-backdrop-filter:saturate(1.6) blur(14px);backdrop-filter:saturate(1.6) blur(14px);padding:14px 16px 12px}
.appbar h1{font-size:24px;letter-spacing:-.01em}
.brand{letter-spacing:.14em;font-size:11px}
.iconbtn{border-radius:14px;box-shadow:var(--shadow);border:1px solid var(--line)}
.screen{gap:18px}
.sec-h h2{font-size:17px}

/* hero */
.hello{position:relative;overflow:hidden;border-radius:26px;padding:20px 20px 22px;background:linear-gradient(135deg,#123F66 0%,#17598F 45%,#2C8BC4 100%);color:#fff;box-shadow:0 16px 34px rgba(23,89,143,.28)}
.hello::before,.hello::after{content:"";position:absolute;border-radius:50%;background:rgba(255,255,255,.10)}
.hello::before{width:180px;height:180px;right:-50px;top:-70px}
.hello::after{width:110px;height:110px;right:60px;bottom:-60px;background:rgba(255,255,255,.07)}
.hello .d{opacity:.8;position:relative}
.hello .big{font-size:26px;position:relative}

/* tiles */
.tiles{gap:12px}
.tile{border-radius:22px;padding:16px;border:1px solid var(--line);gap:8px;transition:transform .15s ease,box-shadow .15s ease}
.tile:hover{transform:translateY(-2px);box-shadow:var(--shadow-lg)}
.tile .ic{width:44px;height:44px;border-radius:14px}
.tile .val{font-size:22px}
.tile[data-go="temp"] .ic{background:var(--c-temp-soft);color:var(--c-temp)}
.tile[data-go="grease"] .ic{background:var(--c-grease-soft);color:var(--c-grease)}
.tile[data-go="seas"] .ic{background:var(--c-seas-soft);color:var(--c-seas)}
.tiles>.tile:first-child{flex-direction:row;align-items:center;flex-wrap:wrap;gap:6px 14px;background:linear-gradient(135deg,var(--surface) 55%,var(--c-temp-soft))}
.tiles>.tile:first-child .lab{flex:1;min-width:120px}

/* surfaces */
.card,.list,.cab,.gcard,.todo{border-radius:var(--r);border:1px solid var(--line);box-shadow:var(--shadow)}
.chip{border-radius:16px;border:1px solid var(--line);padding:10px 14px}
.chip b{font-size:19px}
.daylbl{background:transparent;padding:14px 16px 6px;font-size:12px;letter-spacing:.04em;text-transform:none}
.item>button.main{padding:13px 16px}
.pill{padding:2px 10px}

/* section accents */
#s-temp .cab{border-top:4px solid var(--c-temp)}
#s-grease .gcard{border-top:4px solid var(--c-grease)}
#s-grease .gbox .btn.primary{background:linear-gradient(135deg,#17977C,#0C6E5A);color:#fff}
#s-seas .list{border-top:4px solid var(--c-seas)}
.slot{border-radius:16px;min-height:84px}
.slot.add{border-color:var(--c-temp);background:var(--c-temp-soft)}
.slot.add b{color:var(--c-temp)}

/* inputs & controls */
input,select,textarea{border-radius:14px;border:1.5px solid var(--line);background:var(--surface)}
input:focus,select:focus,textarea:focus{border-color:var(--accent-2);box-shadow:0 0 0 4px var(--accent-soft)}
.stepper input:focus{box-shadow:none}
.seg{border-radius:16px;padding:4px;background:var(--sunk);border:1px solid var(--line)}
.seg button{border-radius:12px}
.btn{border-radius:16px}
.btn.primary{color:#fff;background:linear-gradient(135deg,#2C7DBF,#17598F);box-shadow:0 6px 16px rgba(23,89,143,.25)}
.btn.in{background:linear-gradient(135deg,#17977C,#0C6E5A);color:#fff;box-shadow:0 6px 16px rgba(19,145,120,.25)}
.btn.out{background:linear-gradient(135deg,#2C7DBF,#17598F);color:#fff}
.scanbtn{border-radius:18px}
.scanbtn.out{border-color:var(--c-seas);background:var(--c-seas-soft);color:var(--c-seas-2)}
.namepick button,.bigchoice button,.pickgrid button,.toggles button{border-radius:16px}

/* floating bottom nav */
nav.bottom{bottom:calc(10px + env(safe-area-inset-bottom,0px));width:calc(100% - 24px);max-width:456px;border-radius:26px;border:1px solid var(--glass-line);background:var(--glass);-webkit-backdrop-filter:saturate(1.6) blur(16px);backdrop-filter:saturate(1.6) blur(16px);box-shadow:var(--shadow-lg);padding:4px;padding-bottom:4px}
nav.bottom button{height:var(--nav-h);border-radius:20px;gap:4px;font-size:11.5px}
nav.bottom button[aria-current="page"]::before{display:none}
nav.bottom button svg.i{box-sizing:content-box;padding:4px 16px;border-radius:999px;transition:background .15s}
nav.bottom button[aria-current="page"] svg.i{background:var(--accent-soft)}
nav.bottom button[data-go="temp"][aria-current="page"]{color:var(--c-temp)}
nav.bottom button[data-go="temp"][aria-current="page"] svg.i{background:var(--c-temp-soft)}
nav.bottom button[data-go="grease"][aria-current="page"]{color:var(--c-grease)}
nav.bottom button[data-go="grease"][aria-current="page"] svg.i{background:var(--c-grease-soft)}
nav.bottom button[data-go="seas"][aria-current="page"]{color:var(--c-seas)}
nav.bottom button[data-go="seas"][aria-current="page"] svg.i{background:var(--c-seas-soft)}
nav.bottom .badge{top:6px;left:calc(50% + 10px);box-shadow:0 0 0 2px var(--surface)}
.fab{bottom:calc(var(--nav-h) + 30px + env(safe-area-inset-bottom,0px));border-radius:20px;color:#fff;background:linear-gradient(135deg,#2C7DBF,#17598F);box-shadow:0 10px 24px rgba(23,89,143,.35)}

/* sheet */
.scrim{background:rgba(8,16,24,.5);-webkit-backdrop-filter:blur(2px);backdrop-filter:blur(2px)}
.sheet{border-radius:28px 28px 0 0;box-shadow:0 -10px 40px rgba(0,0,0,.18)}
.sheet .grab{width:44px;margin-top:10px}
.sheet header h2{font-size:20px}
.sheet .foot{background:var(--glass);-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px)}
.toast{bottom:calc(var(--nav-h) + 96px + env(safe-area-inset-bottom,0px));border-radius:16px;box-shadow:var(--shadow-lg)}
@media (prefers-reduced-motion:reduce){.tile{transition:none}.tile:hover{transform:none}}

