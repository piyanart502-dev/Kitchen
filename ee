        $("#fNote").focus();
        return;
      }
      if (!segVal("fRec")) {
        toast("เลือกชื่อผู้บันทึก");
        return;
      }
      lsSet("kw_rec", segVal("fRec"));
      btn.disabled = true;
      ok = await addRec("temps", {
        date: val("fDate"),
        time: val("fTime"),
        ts: val("fDate") + "T" + val("fTime"),
        slot: cabSlots(c).length === 1 ? "ประจำวัน" : segVal("fSlot"),
        cab: c.id,
        cabName: c.name,
        val: v,
        min: c.min,
        max: c.max,
        who: segVal("fRec"),
        note: val("fNote")
      });
      msg = out ? "บันทึกแล้ว (เกินเกณฑ์)" : "บันทึกอุณหภูมิแล้ว";
    } else if (k === "clean" || k === "insp") {
      if (k === "clean" && !segVal("fCleaner")) {
        toast("เลือกชื่อผู้ทำความสะอาด");
        return;
      }
      if (k === "clean" && !sheetPhoto) {
        toast("ถ่ายรูปบ่อหลังทำความสะอาดก่อนลงชื่อ");
        return;
      }
      if (k === "insp" && !segVal("fInsp")) {
        toast("เลือกชื่อผู้ตรวจ");
        return;
      }
      const w = sheetWeek,
        nowD = now();
      let f;
      if (k === "clean") {
        lsSet("kw_cleaner", segVal("fCleaner"));
        f = {
          hasPhoto: true,
          cleanBy: segVal("fCleaner"),
          cleanAt: dKey(nowD),
          cleanTime: tKey(nowD),
          cleanSigned: nowD.toISOString()
        };
        msg = "ลงชื่อทำความสะอาดแล้ว";
      } else {
        const res = segVal("fRes");
        if (res === "ไม่ผ่าน" && !val("fNote")) {
          toast("ระบุสิ่งที่ต้องแก้ไข");
          $("#fNote").focus();
          return;
        }
        const ip = INSPECTORS[+segVal("fInsp")];
        lsSet("kw_insp", segVal("fInsp"));
        f = {
          inspBy: ip.n,
          inspPos: ip.p,
          inspAt: dKey(nowD),
          inspResult: res,
          inspNote: res === "ผ่าน" ? "" : val("fNote"),
          inspSigned: nowD.toISOString()
        };
        msg = "ลงชื่อผู้ตรวจแล้ว";
      }
      btn.disabled = true;
      ok = await writeWeek(w, f, k === "clean" ? sheetPhoto : null);
    } else if (k === "scan") {
      handleCode(val("fCode"));
      return;
    } else if (k === "move") {
      if (segVal("fType") === "in" && val("fCodeIn")) addCode();
      const t = segVal("fType"),
        sel = $("#fItemSel").value,
        q = parseFloat(val("fQty"));
      if (!sel) {
        toast("เลือกรายการที่ตรงกับบาร์โค้ดนี้");
        return;
      }
      if (sel === "__new" && t === "out") {
        toast("รายการใหม่ต้องรับเข้าก่อนจึงจะเบิกได้");
        return;
      }
      if (sel === "__new" && !need([["fNewName", "พิมพ์ชื่อเครื่องปรุง"]])) return;
      if (!(q > 0)) {
        toast("กรอกจำนวนให้มากกว่า 0");
        $("#fQty").focus();
        return;
      }
      if (t === "out" && !segVal("fOutWho")) {
        toast("เลือกชื่อผู้เบิก");
        return;
      }
      const mwho = t === "out" ? segVal("fOutWho") : "";
      if (t === "out") lsSet("kw_out", mwho);
      if (!S.ready) {
        toast("ยังโหลดข้อมูลไม่เสร็จ ลองอีกครั้ง");
        return;
      }
      btn.disabled = true;
      try {
        const r = await api("stockMove", {
          type: t,
          itemId: sel,
          newItem: sel === "__new" ? {
            name: val("fNewName"),
            unit: val("fNewUnit"),
            min: parseFloat(val("fNewMin")) || 0
          } : null,
          qty: q,
          ref: t === "out" ? val("fRef") : "",
          who: mwho,
          date: val("fDate"),
          note: t === "in" ? "" : val("fNote"),
          codes: [...new Set(t === "in" ? inCodes : sheetCode ? [sheetCode] : [])]
        });
        ok = true;
        msg = t === "in" ? "\u0E23\u0E31\u0E1A" + r.name + "\u0E40\u0E02\u0E49\u0E32 " + fmtQ(q) + " " + r.unit : "\u0E40\u0E1A\u0E34\u0E01" + r.name + " " + fmtQ(q) + " " + r.unit + " \xB7 \u0E40\u0E2B\u0E25\u0E37\u0E2D " + fmtQ(r.bal);
        refresh();
      } catch (e2) {
        toast(errMsg(e2, "บันทึกไม่สำเร็จ ลองใหม่อีกครั้ง"));
      }
    } else if (k === "item") {
      const it = sheetItem;
      if (!need([["fName", "พิมพ์ชื่อเครื่องปรุง"]])) return;
      if (!it) {
        const nm = val("fName").trim(),
          codes = val("fCodes").split(/[,\s]+/).filter(Boolean);
        if (S.items.some(i => i.name === nm)) {
          toast("มีรายการนี้อยู่แล้ว");
          return;
        }
        const dup = codes.map(c => itemByCode(c)).find(Boolean);
        if (dup) {
          toast("\u0E1A\u0E32\u0E23\u0E4C\u0E42\u0E04\u0E49\u0E14\u0E19\u0E35\u0E49\u0E40\u0E1B\u0E47\u0E19\u0E02\u0E2D\u0E07 " + dup.name + " \u0E41\u0E25\u0E49\u0E27");
          return;
        }
        btn.disabled = true;
        try {
          await api("addItem", {
            name: nm,
            unit: val("fUnit"),
            min: parseFloat(val("fMin")) || 0,
            codes
          });
          refresh();
          ok = true;
          msg = "เพิ่มรายการแล้ว";
        } catch (e2) {
          toast(errMsg(e2, "เพิ่มรายการไม่สำเร็จ ลองใหม่อีกครั้ง"));
        }
      } else {
        const cnt = val("fCount");
        if (cnt !== "" && !need([["fWho", "กรอกชื่อผู้นับ"]])) return;
        btn.disabled = true;
        try {
          await api("editItem", {
            id: it._id,
            name: val("fName"),
            unit: val("fUnit"),
            min: parseFloat(val("fMin")) || 0,
            codes: val("fCodes").split(/[,\s]+/).filter(Boolean),
            count: cnt,
            who: val("fWho")
          });
          ok = true;
          msg = "บันทึกแล้ว";
          refresh();
        } catch (e2) {
          toast(errMsg(e2, "บันทึกไม่สำเร็จ ลองใหม่อีกครั้ง"));
        }
      }
    } else if (k === "report") {
      if (!sheetReport) return;
      try {
        const a = document.createElement("a");
        a.href = sheetReport.url;
        a.download = sheetReport.name;
        document.body.appendChild(a);
        a.click();
        a.remove();
        toast("ถ้าไม่มีไฟล์ดาวน์โหลด ให้กดค้างที่รูปแล้วบันทึกรูปภาพ");
      } catch (e2) {
        toast("กดค้างที่รูปเพื่อบันทึกรูปภาพ");
      }
      return;
    } else if (k === "pin") {
      const pv = val("fPin");
      if (!pv) {
        toast("ใส่ PIN");
        return;
      }
      lsSet("kw_pin", pv);
      closeSheet();
      await refresh();
      if (!S.ready) setTimeout(askPin, 300);else toast("เข้าใช้งานแล้ว");
      return;
    } else if (k === "settings-temp") {
      const cabs = S.settings.cabinets.map(c => ({
        id: c.id,
        name: val("rn-" + c.id) || c.name,
        min: parseFloat(val("rmin-" + c.id)),
        max: parseFloat(val("rmax-" + c.id))
      }));
      if (cabs.some(c => !isFinite(c.min) || !isFinite(c.max) || c.min >= c.max)) {
        toast("ค่าต่ำสุดต้องน้อยกว่าค่าสูงสุด");
        return;
      }
      btn.disabled = true;
      ok = await saveSettings({
        cabinets: cabs
      });
      msg = "บันทึกเกณฑ์แล้ว";
    } else if (k === "settings-grease") {
      const lines = val("fHol").split("\n").map(x => x.trim()).filter(Boolean),
        hol = [];
      for (const ln of lines) {
        const m = ln.match(/^(\d{4}-\d{2}-\d{2})\s*(.*)$/);
        if (!m || isNaN(new Date(m[1] + "T00:00"))) {
          toast("รูปแบบไม่ถูกต้อง: " + ln);
          return;
        }
        hol.push({
          d: m[1],
          n: m[2] || "วันหยุด"
        });
      }
      btn.disabled = true;
      ok = await saveSettings({
        holidays: hol
      });
      msg = "บันทึกวันหยุดแล้ว";
    }
    btn.disabled = false;
    if (ok) {
      const w = val("fWho");
      if (w) lsSet("kw_who", w);
      const again = k === "move" && sheetCode,
        at = k === "move" ? segVal("fType") : "in";
      closeSheet();
      toast(msg);
      if (again) setTimeout(() => openSheet("scan", {
        type: at
      }), 600);
    }
  };
  const hs = (new URLSearchParams(location.search).get("page") || "").replace(/[^a-z]/g, "") || (location.hash || "").slice(1);
  go(["home", "temp", "grease", "seas"].includes(hs) ? hs : "home");
  $("#dbBanner").hidden = false;
  if (!/^https:\/\/script\.google\.com\/macros\/s\//.test(API_URL)) {
    $("#dbBanner").textContent = "ยังไม่ได้ใส่ลิงก์ Apps Script: แก้บรรทัด API_URL ในไฟล์ index.html";
  } else refresh();
  setInterval(() => {
    if (!sheetKind && document.visibilityState === "visible") refresh();
  }, 6e4);
  document.addEventListener("visibilitychange", () => {
    if (document.visibilityState === "visible" && !sheetKind) refresh();
  });
})();</script>
</body></html>
