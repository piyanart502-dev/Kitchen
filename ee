.lsx{width:44px;height:44px;border-radius:50%;border:0;background:rgba(255,255,255,.15);color:#fff;font-size:20px;cursor:pointer}
.lsview{position:relative;flex:1;overflow:hidden}
.lsview video{width:100%;height:100%;object-fit:cover}
.lsframe{position:absolute;left:8%;right:8%;top:50%;height:34%;transform:translateY(-50%);border:3px solid rgba(255,255,255,.9);border-radius:22px;box-shadow:0 0 0 2000px rgba(0,0,0,.35)}
.lsframe i{position:absolute;left:6%;right:6%;top:50%;height:2px;background:#ff4d4d;box-shadow:0 0 12px #ff4d4d}
.lscan.hit .lsframe{border-color:#3CE0A0;transition:border-color .1s}
.lsinfo{display:flex;justify-content:space-between;gap:10px;padding:14px 16px;font-size:15px}
.lscount{font:700 18px var(--f-mono)}
.lsdone{margin:0 16px calc(16px + env(safe-area-inset-bottom,0px));min-height:54px}
.scanned{border-radius:16px;padding:16px;display:flex;flex-direction:column;gap:4px;text-align:center;background:var(--good-soft);color:var(--good)}
.scanned.out{background:var(--accent-soft);color:var(--accent)}
.scanned small{font-size:13px;opacity:.85}
.scanned b{font:700 28px var(--f-display);color:var(--ink)}
.scanned span{font-size:15px;color:var(--ink)}
.codebox{background:var(--sunk);border-radius:12px;padding:10px 12px;display:flex;justify-content:space-between;align-items:center;gap:8px;font-size:14px}
.codebox b{font-family:var(--f-mono);font-size:16px;letter-spacing:.04em}
.pickgrid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px}
.pickgrid button{min-height:52px;border-radius:12px;border:2px solid var(--line);background:var(--surface);font-size:15px;font-weight:600;cursor:pointer;padding:4px 8px}
.pickgrid button[aria-pressed="true"]{border-color:var(--accent);background:var(--accent-soft);color:var(--accent)}
.codeadd{display:flex;gap:8px}
.codeadd input{flex:1}
.codeadd .btn{min-height:46px}
.codelist{display:flex;flex-direction:column;gap:6px;margin-top:8px}
.codelist:empty{display:none}
