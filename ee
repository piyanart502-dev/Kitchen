<!DOCTYPE html>
<html lang="th"><head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#17598F">
<title>KITCHEN WORK</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Anuphan:wght@500;600;700&family=IBM+Plex+Sans+Thai:wght@400;500;600&family=IBM+Plex+Mono:wght@500;600&display=swap">
<style>
/* Layout: phone app shell — sticky app bar, one scrolling screen, bottom tab bar, + button opens a bottom sheet form */
:root{
  --bg:#E9EEF1; --app:#F4F7F8; --surface:#FFFFFF; --sunk:#EDF1F3; --ink:#172026; --muted:#5A6870; --line:#D6DEE2;
  --accent:#135B8A; --accent-ink:#FFFFFF; --accent-soft:#DFEBF4;
  --good:#1B7A4B; --good-soft:#DFF1E7; --warn:#A5650C; --warn-soft:#FAEFD9; --bad:#BC3326; --bad-soft:#FADFDB; --crit:#7E1D3A; --crit-soft:#F3DAE3;
  --shadow:0 1px 2px rgba(20,40,55,.06),0 4px 14px rgba(20,40,55,.06);
  --f-display:"Anuphan","IBM Plex Sans Thai",system-ui,sans-serif;
  --f-body:"IBM Plex Sans Thai",system-ui,sans-serif;
  --f-mono:"IBM Plex Mono",ui-monospace,Menlo,monospace;
  --nav-h:64px;
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --bg:#0B1013; --app:#11171B; --surface:#1A2227; --sunk:#141B1F; --ink:#E5ECEF; --muted:#97A6AE; --line:#2A353B;
  --accent:#6DB0DD; --accent-ink:#0B1820; --accent-soft:#1A3140;
  --good:#5CC48E; --good-soft:#153126; --warn:#E3A84B; --warn-soft:#382A13; --bad:#F07A6C; --bad-soft:#3C1C19; --crit:#F08FB0; --crit-soft:#3B1725;
  --shadow:0 1px 2px rgba(0,0,0,.3);
  color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#0B1013; --app:#11171B; --surface:#1A2227; --sunk:#141B1F; --ink:#E5ECEF; --muted:#97A6AE; --line:#2A353B;
  --accent:#6DB0DD; --accent-ink:#0B1820; --accent-soft:#1A3140;
  --good:#5CC48E; --good-soft:#153126; --warn:#E3A84B; --warn-soft:#382A13; --bad:#F07A6C; --bad-soft:#3C1C19; --crit:#F08FB0; --crit-soft:#3B1725;
  --shadow:0 1px 2px rgba(0,0,0,.3);
  color-scheme:dark}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{margin:0}
img{max-width:100%}
[hidden]{display:none!important}
:root{padding-top:env(safe-area-inset-top,0px)}
html,body{min-height:100%}
body{background:var(--bg);color:var(--ink);font:15px/1.55 var(--f-body)}
body.lock{overflow:hidden}
h1,h2,h3{font-family:var(--f-display);margin:0;line-height:1.25;text-wrap:balance}
.num{font-family:var(--f-mono);font-variant-numeric:tabular-nums}
button{font:inherit;color:inherit}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
svg.i{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;flex:none}

.app{max-width:480px;margin:0 auto;min-height:100vh;background:var(--app);position:relative;padding-bottom:calc(var(--nav-h) + 28px + env(safe-area-inset-bottom,0px))}
@media (min-width:520px){.app{box-shadow:0 0 0 1px var(--line)}}

.appbar{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;background:var(--app);display:flex;align-items:center;gap:10px;padding:12px 16px 10px;border-bottom:1px solid transparent}
.appbar.scrolled{border-bottom-color:var(--line)}
.appbar .ttl{flex:1;min-width:0}
.appbar h1{font-size:21px;font-weight:700}
.appbar .sub{font-size:12.5px;color:var(--muted)}
.brand{font-family:var(--f-display);font-weight:700;letter-spacing:.08em;font-size:12px;color:var(--accent)}
.iconbtn{width:42px;height:42px;border-radius:50%;border:0;background:var(--surface);box-shadow:var(--shadow);display:grid;place-items:center;cursor:pointer;color:var(--ink)}

.screen{padding-inline:16px;padding-block:6px 16px;display:flex;flex-direction:column;gap:16px}
.sec-h{display:flex;align-items:center;justify-content:space-between;gap:10px}
.sec-h h2{font-size:16px;font-weight:600}
.banner{background:var(--warn-soft);color:var(--warn);border-radius:12px;padding:10px 14px;font-size:14px;font-weight:500}

/* home */
.hello{background:var(--accent);color:var(--accent-ink);border-radius:18px;padding:16px 18px;display:flex;flex-direction:column;gap:4px}
.hello .d{font-size:13px;opacity:.85}
.hello .big{font-family:var(--f-display);font-size:22px;font-weight:600}
.tiles{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.tiles>.tile:first-child{grid-column:1/-1}
.tile{background:var(--surface);border:0;border-radius:16px;box-shadow:var(--shadow);padding:14px;text-align:left;cursor:pointer;display:flex;flex-direction:column;gap:6px;min-width:0}
.tile .ic{width:38px;height:38px;border-radius:11px;display:grid;place-items:center;background:var(--accent-soft);color:var(--accent)}
.tile .lab{font-size:13px;color:var(--muted);line-height:1.35}
.tile .val{font-family:var(--f-display);font-size:20px;font-weight:600;line-height:1.2}
.todo{background:var(--surface);border-radius:16px;box-shadow:var(--shadow);overflow:hidden}
.todo button{display:flex;align-items:center;gap:12px;width:100%;background:none;border:0;border-bottom:1px solid var(--line);padding:13px 14px;text-align:left;cursor:pointer;min-height:56px}
.todo button:last-child{border-bottom:0}
.todo .dot{width:10px;height:10px;border-radius:50%;flex:none}
.todo .tx{flex:1;min-width:0}
.todo .tx small{display:block;color:var(--muted);font-size:12.5px}
.chev{color:var(--muted)}
.done{padding:16px;color:var(--good);font-weight:500;display:flex;gap:10px;align-items:center}

/* lists */
.list{background:var(--surface);border-radius:16px;box-shadow:var(--shadow);overflow:hidden}
.item{border-bottom:1px solid var(--line)}
.item:last-child{border-bottom:0}
.item>button.main{display:flex;align-items:center;gap:12px;width:100%;background:none;border:0;padding:12px 14px;text-align:left;cursor:pointer;min-height:60px}
.item .lead{width:58px;flex:none;text-align:center;font-family:var(--f-mono);font-weight:600;font-size:18px;line-height:1.1}
.item .lead small{display:block;font:500 11px var(--f-body);color:var(--muted)}
.item .mid{flex:1;min-width:0}
.item .mid b{font-weight:600;display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.item .mid span{font-size:12.5px;color:var(--muted);display:block}
.item .more{padding:0 14px 12px 84px;font-size:13.5px;display:flex;flex-direction:column;gap:8px}
.item .more p{margin:0}
.item .more .acts{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.daylbl{font-size:12.5px;font-weight:600;color:var(--muted);padding:10px 14px 4px;background:var(--sunk);letter-spacing:.02em}
.empty{padding:26px 18px;text-align:center;color:var(--muted);font-size:14px}
.pill{display:inline-block;border-radius:999px;padding:1px 9px;font-size:12px;font-weight:600;white-space:nowrap}
.pill.good{background:var(--good-soft);color:var(--good)}.pill.warn{background:var(--warn-soft);color:var(--warn)}
.pill.bad{background:var(--bad-soft);color:var(--bad)}.pill.crit{background:var(--crit-soft);color:var(--crit)}
.pill.none{background:var(--sunk);color:var(--muted)}
.stripe{width:4px;align-self:stretch;border-radius:4px;flex:none}

.cabs{display:flex;flex-direction:column;gap:10px}
.cab{background:var(--surface);border-radius:16px;box-shadow:var(--shadow);padding:12px 14px;display:flex;flex-direction:column;gap:10px}
.cab .head{display:flex;justify-content:space-between;align-items:baseline;gap:8px}
.cab .head small{color:var(--muted);font-size:12.5px}
.slots{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
.slot{border:1.5px dashed var(--line);border-radius:12px;padding:8px;text-align:center;background:none;cursor:pointer;display:flex;flex-direction:column;gap:1px;min-height:74px;justify-content:center}
.slot span{font-size:12px;color:var(--muted)}
.slots.one{grid-template-columns:1fr}
.slot b{font-family:var(--f-mono);font-size:19px;font-weight:600}
.slot.good{border:1.5px solid var(--good);background:var(--good-soft)} .slot.good b{color:var(--good)}
.slot.bad{border:1.5px solid var(--bad);background:var(--bad-soft)} .slot.bad b{color:var(--bad)}
.slot.add b{color:var(--accent);font-family:var(--f-body);font-size:15px}

.card{background:var(--surface);border-radius:16px;box-shadow:var(--shadow);padding:14px;display:flex;flex-direction:column;gap:10px}
.chart svg{width:100%;height:auto;display:block}
.chart text{fill:var(--muted);font-family:var(--f-mono);font-size:10px}
.hint{font-size:12.5px;color:var(--muted);margin:0}

.seg{display:flex;background:var(--sunk);border-radius:12px;padding:3px;gap:3px}
.seg button{flex:1;border:0;background:none;border-radius:9px;padding:8px 6px;font-size:14px;font-weight:500;color:var(--muted);cursor:pointer;min-height:40px}
.seg button[aria-pressed="true"]{background:var(--surface);color:var(--ink);box-shadow:var(--shadow);font-weight:600}
.filterbar{display:flex;gap:8px;align-items:center}
.filterbar input{flex:1}
.chips{display:flex;flex-wrap:wrap;gap:8px}
.chip{background:var(--surface);box-shadow:var(--shadow);border-radius:12px;padding:8px 12px;font-size:13.5px;display:flex;flex-direction:column;min-width:0}
.chip b{font-family:var(--f-mono);font-size:17px;font-weight:600}
.chip small{color:var(--muted);font-size:12px}

/* inputs */
input,select,textarea{font:16px var(--f-body);color:var(--ink);background:var(--sunk);border:1.5px solid transparent;border-radius:12px;padding:11px 12px;width:100%;min-width:0;min-height:46px}
textarea{min-height:72px;resize:vertical}
input:focus,select:focus,textarea:focus{outline:none;border-color:var(--accent);background:var(--surface)}
label.f{display:flex;flex-direction:column;gap:5px;font-size:13px;font-weight:500;color:var(--muted);min-width:0}
.row2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.btn{border:0;border-radius:14px;min-height:50px;padding:0 18px;font-weight:600;font-size:16px;cursor:pointer}
.btn.primary{background:var(--accent);color:var(--accent-ink)}
.btn.ghost{background:var(--sunk);color:var(--ink)}
.btn.sm{min-height:36px;font-size:13.5px;border-radius:10px;padding:0 12px}
.btn.danger{background:var(--bad-soft);color:var(--bad)}
.btn:disabled{opacity:.5}
.toggles{display:flex;flex-wrap:wrap;gap:8px}
.toggles button{border:1.5px solid var(--line);background:var(--surface);border-radius:999px;padding:8px 14px;font-size:14px;cursor:pointer;min-height:42px}
.toggles button[aria-pressed="true"]{border-color:var(--accent);background:var(--accent-soft);color:var(--accent);font-weight:600}
.stepper{display:flex;align-items:center;gap:10px;background:var(--sunk);border-radius:16px;padding:10px}
.stepper button{width:56px;height:56px;border-radius:14px;border:0;background:var(--surface);box-shadow:var(--shadow);font-size:26px;font-weight:600;cursor:pointer;flex:none}
.stepper input{background:none;border:0;text-align:center;font:600 36px var(--f-mono);padding:0;min-height:56px}
.stepper input:focus{background:none}
.verdict{text-align:center;font-size:13.5px;min-height:22px}
.scale{display:grid;grid-template-columns:repeat(5,1fr);gap:6px}
.scale button{min-height:46px;border-radius:12px;border:1.5px solid var(--line);background:var(--surface);font:600 17px var(--f-mono);cursor:pointer}
.scale button[aria-pressed="true"]{border-color:var(--accent);background:var(--accent);color:var(--accent-ink)}
.scalecap{display:flex;justify-content:space-between;font-size:11.5px;color:var(--muted);margin-top:-2px}
.scorebox{border-radius:14px;padding:12px;text-align:center;font-weight:600}
.lv-low{background:var(--good-soft);color:var(--good)}.lv-med{background:var(--warn-soft);color:var(--warn)}
.lv-high{background:var(--bad-soft);color:var(--bad)}.lv-ext{background:var(--crit-soft);color:var(--crit)}

/* bottom nav + fab */
nav.bottom{position:fixed;left:50%;transform:translateX(-50%);bottom:0;width:100%;max-width:480px;z-index:6;background:var(--surface);border-top:1px solid var(--line);display:grid;grid-template-columns:repeat(4,1fr);padding-bottom:env(safe-area-inset-bottom,0px)}
nav.bottom button{border:0;background:none;height:var(--nav-h);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;font-size:11px;color:var(--muted);cursor:pointer;position:relative}
nav.bottom button[aria-current="page"]{color:var(--accent);font-weight:600}
nav.bottom button[aria-current="page"]::before{content:"";position:absolute;top:0;width:28px;height:3px;border-radius:0 0 3px 3px;background:var(--accent)}
nav.bottom .badge{position:absolute;top:8px;left:calc(50% + 6px);min-width:17px;height:17px;border-radius:9px;background:var(--bad);color:#fff;font:600 10.5px/17px var(--f-mono);padding:0 4px}
.fab{position:fixed;z-index:6;bottom:calc(var(--nav-h) + 16px + env(safe-area-inset-bottom,0px));right:max(16px,calc(50% - 240px + 16px));height:56px;border-radius:18px;border:0;background:var(--accent);color:var(--accent-ink);display:flex;align-items:center;gap:8px;padding:0 20px 0 16px;font-weight:600;font-size:15.5px;box-shadow:0 6px 18px rgba(19,91,138,.35);cursor:pointer}

/* sheet */
.scrim{position:fixed;inset:0;z-index:20;background:rgba(10,18,24,.45);display:flex;align-items:flex-end;justify-content:center}
.sheet{width:100%;max-width:480px;max-height:92vh;background:var(--app);border-radius:22px 22px 0 0;display:flex;flex-direction:column;animation:up .22s ease-out}
@keyframes up{from{transform:translateY(40px);opacity:.6}to{transform:none;opacity:1}}
.sheet .grab{width:40px;height:5px;border-radius:3px;background:var(--line);margin:8px auto 0}
.sheet header{display:flex;align-items:center;gap:10px;padding:8px 16px 10px}
.sheet header h2{flex:1;font-size:19px}
.sheet .body{overflow-y:auto;padding-inline:16px;padding-block:4px 16px;display:flex;flex-direction:column;gap:14px;-webkit-overflow-scrolling:touch}
.sheet .foot{padding:12px 16px calc(12px + env(safe-area-inset-bottom,0px));border-top:1px solid var(--line);background:var(--app)}
.sheet .foot .btn{width:100%}
.toast{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(var(--nav-h) + 86px + env(safe-area-inset-bottom,0px));z-index:30;background:var(--ink);color:var(--app);padding:10px 18px;border-radius:999px;font-weight:500;font-size:14px;max-width:calc(100% - 32px);text-align:center}
.step{display:flex;gap:12px;align-items:flex-start;padding:12px 0;border-top:1px solid var(--line)}
.step:first-of-type{border-top:0;padding-top:4px}
.step .no{width:30px;height:30px;border-radius:50%;flex:none;display:grid;place-items:center;font:600 14px var(--f-mono);background:var(--sunk);color:var(--muted)}
.step.ok .no{background:var(--good);color:var(--surface)}
.step.late .no{background:var(--bad);color:var(--surface)}
.step .bd{flex:1;min-width:0;display:flex;flex-direction:column;gap:4px}
.step .bd b{font-weight:600}
.step .bd .dim{font-size:13px;color:var(--muted)}
.step .btn{align-self:flex-start;margin-top:4px}
.shift{font-size:12.5px;background:var(--warn-soft);color:var(--warn);border-radius:8px;padding:4px 8px;align-self:flex-start}
.weekhd{display:flex;justify-content:space-between;align-items:baseline;gap:8px}
.weekhd small{color:var(--muted);font-size:13px}
.card.past{border:1.5px solid var(--bad)}
.gcard{background:var(--surface);border-radius:18px;box-shadow:var(--shadow);overflow:hidden}
.gcard .top{padding:14px 16px 6px;color:var(--muted);font-size:13.5px}
.gcard .top b{display:block;color:var(--ink);font:600 18px var(--f-display)}
.gbox{display:flex;align-items:center;gap:14px;padding:14px 16px;border-top:1px solid var(--line)}
.gbox .ic{width:48px;height:48px;border-radius:14px;flex:none;display:grid;place-items:center;font-size:22px;font-weight:700;background:var(--sunk);color:var(--muted)}
.gbox.ok .ic{background:var(--good-soft);color:var(--good)}
.gbox.no .ic{background:var(--bad-soft);color:var(--bad)}
.gbox .tx{flex:1;min-width:0;display:flex;flex-direction:column}
.gbox .tx b{font-size:16px;font-weight:600}
.gbox .tx span{font-size:13px;color:var(--muted)}
.gbox .tx .who{font-size:15px;color:var(--ink);font-weight:500}
.gbox .btn{min-height:48px;padding:0 20px}
.gbox .sh{color:var(--warn)}
.ghist{display:grid;grid-template-columns:64px 1fr 1fr;gap:8px;align-items:center;padding:10px 14px;border-bottom:1px solid var(--line);font-size:13.5px}
.ghist:last-child{border-bottom:0}
.ghist .d{font-weight:600;font-size:14px;line-height:1.2}
.ghist .d small{display:block;font-weight:400;color:var(--muted);font-size:11.5px}
.gcell{display:flex;flex-direction:column;min-width:0}
.gcell small{color:var(--muted);font-size:11.5px}
.gcell span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.gcell .ok{color:var(--good);font-weight:500}.gcell .bad{color:var(--bad);font-weight:500}
.gcell button{align-self:flex-start;border:1.5px solid var(--accent);color:var(--accent);background:none;border-radius:999px;padding:2px 12px;font-size:13px;font-weight:600;cursor:pointer;min-height:30px}
.bigchoice{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.bigchoice button{min-height:64px;border-radius:14px;border:2px solid var(--line);background:var(--surface);font-size:17px;font-weight:600;cursor:pointer}
.bigchoice button[data-v="ผ่าน"][aria-pressed="true"]{border-color:var(--good);background:var(--good-soft);color:var(--good)}
.bigchoice button[data-v="ไม่ผ่าน"][aria-pressed="true"]{border-color:var(--bad);background:var(--bad-soft);color:var(--bad)}
.signfor{background:var(--sunk);border-radius:14px;padding:12px 14px;font-size:14px}
.signfor b{display:block;font:600 17px var(--f-display)}
.namepick{display:flex;flex-direction:column;gap:10px;margin-top:6px}
.namepick button{min-height:60px;border-radius:14px;border:2px solid var(--line);background:var(--surface);font-size:17px;font-weight:600;cursor:pointer;text-align:left;padding:0 16px;display:flex;align-items:center;gap:12px}
.namepick button::before{content:"";width:22px;height:22px;border-radius:50%;border:2px solid var(--line);flex:none}
.namepick button[aria-pressed="true"]{border-color:var(--accent);background:var(--accent-soft);color:var(--accent)}
.namepick button[aria-pressed="true"]::before{border:7px solid var(--accent)}
.inout{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.inout .btn{min-height:60px;font-size:17px;border-radius:16px;display:flex;align-items:center;justify-content:center;gap:8px}
.btn.in{background:var(--good);color:var(--surface)}
.btn.out{background:var(--accent);color:var(--accent-ink)}
.qin{color:var(--good)}.qout{color:var(--accent)}.qadj{color:var(--warn)}
.balhint{background:var(--sunk);border-radius:12px;padding:10px 12px;font-size:14px;display:flex;justify-content:space-between;gap:8px}
.balhint b{font-family:var(--f-mono)}
.mini{display:flex;flex-direction:column;gap:2px;font-size:13px}
.mini span{display:flex;justify-content:space-between;gap:8px}
.scanbtn{width:100%;min-height:64px;border-radius:16px;border:2px dashed var(--good);background:var(--good-soft);color:var(--good);font-size:17px;font-weight:600;display:flex;align-items:center;justify-content:center;gap:10px;cursor:pointer}
.scanbtn.out{border-color:var(--accent);background:var(--accent-soft);color:var(--accent)}
.scanbig{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;min-height:150px;border-radius:18px;border:2px dashed var(--accent);background:var(--accent-soft);color:var(--accent);font-weight:600;font-size:17px;cursor:pointer;text-align:center;padding:16px}
.scanbig small{font-weight:400;font-size:13px;color:var(--muted)}
.scanbig svg.i{width:44px;height:44px}
.scanmsg{text-align:center;font-size:14px;min-height:22px}
.photobox{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;min-height:140px;border-radius:16px;border:2px dashed var(--accent);background:var(--accent-soft);color:var(--accent);font-weight:600;cursor:pointer;overflow:hidden;margin-top:6px;text-align:center}
.photobox img{width:100%;max-height:280px;object-fit:cover;display:block}
.photobox svg.i{width:38px;height:38px}
.photobox.has{border-style:solid}
.thumb{width:64px;height:64px;border-radius:12px;object-fit:cover;border:0;padding:0;cursor:pointer;background:var(--sunk);flex:none;display:block}
